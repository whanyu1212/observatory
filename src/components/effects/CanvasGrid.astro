<canvas
  id="cyber-grid-canvas"
  class="fixed inset-0 pointer-events-none z-0 h-full w-full"
  aria-hidden="true"
></canvas>

<script>
  const canvas = document.getElementById('cyber-grid-canvas') as HTMLCanvasElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pointer = { x: -1000, y: -1000 };
    let width = window.innerWidth;
    let height = window.innerHeight;
    let pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
    let meshColor = '102, 217, 232';
    let frame = 0;

    interface MeshNode {
      x: number;
      y: number;
      originX: number;
      originY: number;
      phase: number;
      radius: number;
    }

    let nodes: MeshNode[] = [];

    const syncThemeColor = () => {
      meshColor = getComputedStyle(document.documentElement)
        .getPropertyValue('--mesh-rgb')
        .trim() || '102, 217, 232';
    };

    const createNodes = () => {
      const count = Math.min(68, Math.max(30, Math.round((width * height) / 26000)));
      nodes = Array.from({ length: count }, () => {
        const x = Math.random() * width;
        const y = Math.random() * height;
        return {
          x,
          y,
          originX: x,
          originY: y,
          phase: Math.random() * Math.PI * 2,
          radius: Math.random() * 0.8 + 0.6,
        };
      });
    };

    const resize = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx?.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      createNodes();
    };

    const drawDotMatrix = () => {
      if (!ctx) return;
      ctx.fillStyle = `rgba(${meshColor}, 0.065)`;
      for (let x = 20; x < width; x += 32) {
        for (let y = 20; y < height; y += 32) {
          ctx.fillRect(x, y, 1, 1);
        }
      }
    };

    const draw = () => {
      if (!ctx) return;

      ctx.clearRect(0, 0, width, height);
      drawDotMatrix();

      nodes.forEach((node, index) => {
        if (!reducedMotion) {
          node.x = node.originX + Math.sin(frame * 0.006 + node.phase) * 10;
          node.y = node.originY + Math.cos(frame * 0.004 + node.phase) * 8;
        }

        const pointerDistance = Math.hypot(node.x - pointer.x, node.y - pointer.y);
        const isPointerNear = pointerDistance < 190;
        const nodeAlpha = isPointerNear ? 0.7 : 0.2;

        ctx.fillStyle = `rgba(${meshColor}, ${nodeAlpha})`;
        ctx.beginPath();
        ctx.arc(node.x, node.y, isPointerNear ? node.radius + 0.7 : node.radius, 0, Math.PI * 2);
        ctx.fill();

        if (isPointerNear) {
          ctx.strokeStyle = `rgba(${meshColor}, ${(1 - pointerDistance / 190) * 0.24})`;
          ctx.beginPath();
          ctx.moveTo(pointer.x, pointer.y);
          ctx.lineTo(node.x, node.y);
          ctx.stroke();
        }

        for (let otherIndex = index + 1; otherIndex < nodes.length; otherIndex++) {
          const other = nodes[otherIndex];
          const distance = Math.hypot(node.x - other.x, node.y - other.y);
          if (distance < 115) {
            ctx.strokeStyle = `rgba(${meshColor}, ${(1 - distance / 115) * 0.08})`;
            ctx.beginPath();
            ctx.moveTo(node.x, node.y);
            ctx.lineTo(other.x, other.y);
            ctx.stroke();
          }
        }
      });

      frame += 1;
      requestAnimationFrame(draw);
    };

    window.addEventListener('resize', resize);
    window.addEventListener('pointermove', (event) => {
      pointer.x = event.clientX;
      pointer.y = event.clientY;
    }, { passive: true });
    window.addEventListener('pointerleave', () => {
      pointer.x = -1000;
      pointer.y = -1000;
    });

    new MutationObserver(syncThemeColor).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    syncThemeColor();
    resize();
    draw();
  }
</script>
