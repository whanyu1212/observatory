---
import HUDLayout from '@/layouts/HUDLayout.astro';
import { getImage } from 'astro:assets';
import gemPreview from '../assets/gem-dota-preview.png';
import gemMap from '../assets/gem-map.jpg';
import { Observatory } from '@/components/observatory/Observatory';

const preview = await getImage({ src: gemPreview, width: 1120, format: 'webp' });
const map = await getImage({ src: gemMap, width: 1000, format: 'webp' });
---

<HUDLayout title="Hanyu Wu — The Observatory">
  <Observatory client:load projectImage={preview.src} mapImage={map.src} />
</HUDLayout>
