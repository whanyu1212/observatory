---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@/styles/global.css';
import '@/styles/observatory.css';

interface Props {
  title?: string;
  /** Error pages opt out of indexing and canonical URLs. */
  noindex?: boolean;
}

const { title = 'Hanyu Wu — The Observatory', noindex = false } = Astro.props;
const description = 'Hanyu Wu. Curious by default. Learning by building. Explore the questions behind my work in AI agents, data tools, and reinforcement learning.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="observatory">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

    <!-- Link previews (LinkedIn, Slack, iMessage, Discord, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Observatory" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Follow your curiosity: Hanyu Wu's portfolio, ten projects as floating islands in a 3D universe." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@queryverse_hy" />
    <meta name="theme-color" content="#0a1012" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="app-shell">
    <slot />
  </body>
</html>
