---
import '@/styles/global.css';
import '@/styles/observatory.css';

interface Props {
  title?: string;
}

const { title = 'Hanyu Wu — The Observatory' } = Astro.props;
const description = 'Hanyu Wu. Curious by default. Learning by building. Explore the questions behind my work in AI agents, data tools, and reinforcement learning.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="observatory">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Link previews (LinkedIn, Slack, iMessage, Discord, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Observatory" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Follow your curiosity: Hanyu Wu's portfolio, ten projects as floating islands in a 3D universe." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@queryverse_hy" />
    <meta name="theme-color" content="#0a1012" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="app-shell">
    <slot />
  </body>
</html>
